# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored -- never commit your real .env file.
#
# The database username/password are NOT configured here; they're entered
# at the application's login screen and used directly as your MySQL
# credentials (see README "Getting Started").

GLIMS_DB_URL=jdbc:mysql://localhost:3306/genlab_db
